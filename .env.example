# ==============================================================================
# CONFIGURAÇÕES DE AMBIENTE - CENTRAL DE INTELIGÊNCIA DE AVALIAÇÕES MOBILE
# ==============================================================================

# --- PARAMETRIZAÇÃO DO APLICATIVO MONITORADO (WHITE-LABEL / MULTI-APP) ---
# Você pode monitorar qualquer app preenchendo as variáveis abaixo ou editando app_config.json:
APP_NAME=Minha Escola MG
ORGANIZATION_NAME=Governo de Minas Gerais / Prodemge
DEVELOPER_NAME=Prodemge - Tecnologia da Informação de MG
GOOGLE_PLAY_PACKAGE=com.prodemge.minhaescolamg
APPLE_STORE_ID=6749247611
APPLE_STORE_COUNTRY=br
SUPPORT_CHANNEL_URL=https://forms.cloud.microsoft/r/JmZhSzXtwG
SUPPORT_EMAIL=suporte@exemplo.mg.gov.br

# --- AUTENTICAÇÃO GOOGLE IDENTITY SERVICES ---
# Google Cloud OAuth 2.0 (Google Identity Services)
# Obtenha em: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=seu_client_id_aqui.apps.googleusercontent.com

# Chave secreta para assinatura dos cookies de sessão (JWT)
SECRET_KEY=sua-chave-secreta-aleatoria-prodemge-2026

# E-mail do Administrador Geral (Já configurado nativamente no banco)
ADMIN_EMAIL=saulomartins.costa@gmail.com

# --- INTELIGÊNCIA ARTIFICIAL GOOGLE GEMINI ---
# Chave de IA do Google Gemini (Opcional - pode ser configurada na interface web)
# Obtenha gratuitamente em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- SERVIDOR WEB ---
# Porta do Servidor Web Local (Padrão: 8055)
PORT=8055
